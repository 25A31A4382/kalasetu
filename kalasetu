/* ================= OFFLINE ASSISTANCE & AUTO-SYNC ================= */
const NET = { sim:false, syncing:false };
function netDown(){ return NET.sim || (typeof navigator!=='undefined' && navigator.onLine===false); }
function lowConn(){ try{ const c=navigator.connection; return !!(c && /2g/.test(c.effectiveType||'')); }catch(e){ return false; } }
function queueSync(type, label){
  S.outbox.push({ id:uid(), ts:now(), type:type, label:label });
  save(); render(); toast('📴 '+t('net_off')+' — saved, will sync');
}
function syncOutbox(){
  if(netDown() || NET.syncing || !S.outbox.length) return;
  NET.syncing = true; render();
  const n = S.outbox.length;
  setTimeout(function(){
    S.outbox = []; S.lastSync = Date.now(); NET.syncing = false; save(); render();
    toast(t('sync_a')+n+t('sync_b'));
    const u = me(); if(u) notify(u.id,'inapp', t('sync_a')+n+t('sync_b'));
  }, 900);
}
function toggleSim(){
  NET.sim = !NET.sim; render();
  if(!NET.sim) syncOutbox();          /* "network back" -> auto-sync */
}
function netStrip(){
  let h='';
  if(netDown()){
    h += '<div style="background:#fffbeb;border-bottom:1px solid #fde68a;color:#92400e;padding:10px 14px;font-size:13.5px;line-height:1.45"><b>📴 '+t('net_off')+'</b> — '+t('off_banner')+'</div>';
  } else if(lowConn()){
    h += '<div style="background:#eff6ff;border-bottom:1px solid #bfdbfe;color:#1e40af;padding:8px 14px;font-size:13px">'+t('weak')+'</div>';
  }
  if(S.outbox && S.outbox.length){
    h += '<div class="row" style="background:#eef2ff;border-bottom:1px solid #c7d2fe;color:#312e81;padding:10px 14px;font-size:13.5px"><span>📤 <b>'+S.outbox.length+'</b> '+t('pend')+'</span>'
      + (netDown() ? '' : '<button class="btn sm" style="margin-left:10px" onclick="syncOutbox()">'+(NET.syncing?'⏳ syncing…':t('sync_now'))+'</button>')
      + (S.lastSync ? '<span style="margin-left:10px;opacity:.75">'+t('last')+': '+new Date(S.lastSync).toLocaleTimeString()+'</span>' : '')
      + '</div>';
  }
  return h;
}
/* real network events (deployed) */
try{
  window.addEventListener('online', function(){ NET.sim=false; render(); syncOutbox(); });
  window.addEventListener('offline', function(){ render(); });
}catch(e){}
/* service worker: full offline reload after first visit (needs https hosting) */
try{
  if(typeof navigator!=='undefined' && navigator.serviceWorker && typeof location!=='undefined' && /^https?:$/.test(location.protocol)){
    navigator.serviceWorker.register('sw.js').catch(function(){});
  }
}catch(e){}

render();

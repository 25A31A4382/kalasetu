function logCard(o){
  const p = prodById(o.productId); const c = userById(o.customerId); const a = userById(o.artisanId);
  let act='';
  if(o.status==='assigned'){ act = '<button class="btn sm" onclick="advance('+o.id+',\'picked\')">'+t('pick')+'</button>'; }
  else if(o.status==='picked'){ act = '<button class="btn sm amb" onclick="advance('+o.id+',\'out\')">'+t('out')+'</button>'; }
  else if(o.status==='out'){ act = '<div class="row"><span class="sub">'+t('pay_mode')+' ('+fmt(o.total||o.amount)+'):</span><button class="btn sm grn" onclick="advance('+o.id+',\'paid\',\'upi\')">💳 '+t('upi')+'</button><button class="btn sm grn" onclick="advance('+o.id+',\'paid\',\'cash\')">💵 '+t('cash')+'</button></div>'; }
  else if(o.status==='rt_requested'){ act = '<div class="row"><span class="b pending">↩ '+t('r'+({r1:1,r2:2,r3:3,r4:4}[o.return&&o.return.reason]||1))+'</span><button class="btn sm amb" onclick="advance('+o.id+',\'rt_picked\')">📦 '+t('rt_picked')+'</button></div>'; }
  else if(o.status==='rt_picked'){ act = '<button class="btn sm red" onclick="advance('+o.id+',\'rt_refunded\')">💰 '+t('rt_refunded')+' · '+fmt(returnRefundOf(o))+'</button>'; }
  else if(o.status==='rt_refunded'){ act = '<span class="b grey">↩ '+t('rt_refunded')+' · '+fmt(returnRefundOf(o))+'</span>'; }
  else { act = '<span class="b approved">'+t('st_paid')+' · '+(o.payMethod==='upi'?t('upi'):t('cash'))+'</span><div class="sub" style="margin-top:6px">'+t('pay_split_note')+'</div>'; }
  const doneSplit = (o.status==='paid'||o.status==='rt_refunded') ? '<div class="sub" style="font-size:12px; margin-top:6px">✓ '+fmt(o.amount)+' → '+t('role_artisan')+' · '+fmt(o.fee||DELIVERY_FEE)+' → '+t('role_logistics')+'</div>' : '';
  return '<div class="card mt"><div class="row"><img class="thumb" src="'+p.img+'"><div style="flex:1;min-width:0"><b>'+esc(pname(p))+'</b>'
    + '<div class="sub">'+t('v_by')+' '+esc(a?a.name:'')+' → 👤'+esc(c?c.name:'')+'<br>📍 '+esc(o.addr||'—')+'</div></div>'
    + '<div style="text-align:right"><b>'+fmt(o.total||o.amount)+'</b><div class="sub">#'+o.id+'</div></div></div>'
    + '<div class="mt">'+act+'</div>'+doneSplit+'</div>';
}
function advance(id, st, mode){
  const o = S.orders.find(x=>x.id===id); if(!o) return;
  o.status = st;
  if(st==='paid'){ o.payMethod = mode; }
  const p = prodById(o.productId);
  if(st==='picked'){ notify(o.customerId,'inapp', t_en('prod_picked',{p:p.name_en})); }
  if(st==='out'){ notify(o.customerId,'multi', t_en('prod_out',{p:p.name_en, amt:fmt(o.total||o.amount)})); }
  if(st==='paid'){
    /* money split: product amount → artisan · delivery fee → logistics dept */
    notify(o.customerId,'inapp', t_en('receipt_c',{p:p.name_en, total:fmt(o.total||o.amount), mode: mode==='upi'?t('upi'):t('cash')}));
    notify(o.artisanId,'multi', t_en('art_credit',{p:p.name_en, amt:fmt(o.amount)}));
    toast(t('paid_split',{total:fmt(o.total||o.amount), amt:fmt(o.amount), fee:fmt(DELIVERY_FEE)}));
  }
  if(st==='rt_picked'){
    notify(o.customerId,'multi', t_en('rt_picked_c',{p:p.name_en, amt:fmt(returnRefundOf(o))}));
    notify(o.artisanId,'multi', t_en('rt_picked_a',{p:p.name_en}));
  }
  if(st==='rt_refunded'){
    notify(o.customerId,'multi', t_en('rt_refunded_c',{p:p.name_en, amt:fmt(returnRefundOf(o))}));
    notify(o.artisanId,'inapp', t_en('rt_refunded_a',{p:p.name_en}));
    toast('💰 '+fmt(returnRefundOf(o))+' ✓');
  }
  save(); render();
}
/* refund = product + delivery for genuine issues; product only for change-of-mind */
function returnRefundOf(o){
  return (o.return && o.return.reason==='r4') ? (o.amount||0) : (o.total||o.amount||0);
}
/* customer requests a return (7-day policy) */
function requestReturn(id, reason){
  const o = S.orders.find(x=>x.id===id); if(!o) return;
  o.return = {reason:reason, ts:now()};
  o.status = 'rt_requested';
  const p = prodById(o.productId);
  const log = userById(o.logisticsId);
  if(log) notify(log.id,'inapp', t_en('ret_new_task',{p:p.name_en}));
  notify(o.artisanId,'inapp', t_en('art_ret_note',{p:p.name_en}));
  notify(o.customerId,'inapp', t_en('rt_ok',{p:p.name_en}));
  if(netDown()) queueSync('return', p.name_en);    /* offline: queued for auto-sync */
  ui.retOpen = null;
  save(); render(); toast(t('rt_ok',{p:pname(p)}));
}

function chatSend(){
  const inp = document.getElementById('chatIn'); const v = inp.value.trim(); if(!v) return;
  chatPush('me', v); inp.value='';
  const low = v.toLowerCase();
  let reply;
  if(/otp|verify|सत्य|ధృవ/.test(low)) reply = t('a1');

function calcSug(){
  W.cost = Math.max(0, +document.getElementById('w_cost').value||0);
  W.hours = Math.max(0, +document.getElementById('w_hours').value||0);
  const cat = cats.find(c=>c.id===(W.gen?W.gen.cat:'saree')) || cats[cats.length-1];
  const floor = Math.round(W.cost*2 + W.hours*60);   /* materials×2 + fair skilled wage ₹60/hr */
  const band = cat.idx;
  let sug = Math.max(floor, band.med);               /* never below the fair-wage floor */
  sug = Math.min(sug, Math.max(floor+1, Math.round(band.hi*1.15)));
  W.sug = {floor:floor, cost:W.cost, hrs:W.hours, band:band, sug:sug, conf:82, cat:cat.id};
  W.price = sug;
  render();
}

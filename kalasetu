  if(log) notify(log.id,'inapp', t_en('log_new_task',{p:p.name_en, n:userById(p.artisanId).name}));
  notify(m.id,'inapp', t_en('cust_new_order',{p:p.name_en, amt:fmt(p.price)}));
  save(); toast(t('order_ok')); go('c_orders');
}

      retUi += '<div class="card" style="background:#fffbeb; margin-top:8px"><b>'+t('ret_reason')+'</b><div class="row mt8">'
        + [1,2,3,4].map(n=>'<button class="btn sm '+(n===4?'sec':'amb')+'" onclick="requestReturn('+o.id+',\'r'+n+'\')">'+t('r'+n)+'</button>').join('') + '</div>'
        + '<div class="sub" style="font-size:12px; margin-top:6px">'+t('pol3_d')+'</div></div>';
    }
    retUi += '</div>';
  }
  if(o.return && o.status!=='rt_refunded'){
    retUi += '<div class="mt"><span class="b pending">↩ '+t(labels[o.status])+'</span></div>';
  }
  return '<div class="card"><div class="row"><img class="thumb" src="'+p.img+'"><div style="flex:1; min-width:0"><b>'+esc(pname(p))+'</b>'
    + '<div class="sub">'+fmt(o.total||o.amount)+' · #'+o.id+' · '+tstr(o.created)+'</div></div>'
    + '<span class="b '+stCls+'">'+t(labels[o.status]||o.status)+'</span></div>'
    + (isCust ? '<div class="sub mt8" style="font-size:12.5px">📍 '+t('track_t')+' · '+t('agent_by')+': <b>'+esc(agent?agent.name.split('—')[0].trim():'—')+'</b></div>' : '')
    + '<hr><div class="tl">'+steps.map((s,i)=>'<div class="tli'+(i<=idx?' done':'')+'">'+t(labels[s])+'</div>').join('')+'</div>'
    + (isCust ? '<div class="sub" style="font-size:12px">🧾 '+t('bill')+': '+fmt(o.amount)+' + '+fmt(o.fee||DELIVERY_FEE)+' ('+t('del_fee')+') = '+fmt(o.total||o.amount)+'</div>' : '')
    + retUi + '</div>';
}


/* ---- photo pick + VALIDATION (rejects humans) ---- */
function photoPicked(el){
  const f = el.files && el.files[0]; if(!f) return;
  const rd = new FileReader();
  rd.onload = function(){
    const img = new Image();
    img.onload = function(){
      const c=document.createElement('canvas'); const max=900;
      let w=img.width,h=img.height;
      /* basic validity checks */
      if(w<280||h<280){ W.err='invalid_lowres'; W.raw=null; W.img=null; render(); return; }
      const sc=Math.min(1,max/Math.max(w,h)); w=Math.round(w*sc); h=Math.round(h*sc);
      c.width=w; c.height=h; c.getContext('2d').drawImage(img,0,0,w,h);
      W.err=null;
      W.raw = c.toDataURL('image/jpeg', lowConn()?0.5:0.75);   /* weak network: lighter photo */
      W.img = W.raw; W.enhanced=false; ui.cmp=100; render();
    };
    img.onerror = function(){ W.err='invalid_lowres'; render(); };
    img.src = rd.result;
  };
  rd.readAsDataURL(f);
}
/* production: server-side person detection (MediaPipe BlazeFace / cloud vision).
   demo: YCbCr skin-region heuristic — rejects person-dominated photos. */

function doEnhance(){
  toast(t('enhancing'));
  const img = new Image();
  img.onload = function(){
    const c=document.createElement('canvas'); const max=900;
    let w=img.width,h=img.height; const sc=Math.min(1,max/Math.max(w,h)); w=Math.round(w*sc); h=Math.round(h*sc);
    c.width=w; c.height=h; const x=c.getContext('2d'); x.drawImage(img,0,0,w,h);
    const d=x.getImageData(0,0,w,h); const p=d.data;
    const hist=new Array(256).fill(0);
    for(let i=0;i<p.length;i+=4){ const l=(p[i]*0.299+p[i+1]*0.587+p[i+2]*0.114)|0; hist[l]++; }
    const total=w*h; let lo=0,hi=255,acc=0;
    for(let i=0;i<256;i++){ acc+=hist[i]; if(acc>total*0.02){ lo=i; break; } }
    acc=0; for(let i=255;i>=0;i--){ acc+=hist[i]; if(acc>total*0.02){ hi=i; break; } }
    const range=Math.max(1,hi-lo), sat=1.22;
    for(let i=0;i<p.length;i+=4){
      for(let ch=0;ch<3;ch++){ let v=(p[i+ch]-lo)*255/range; p[i+ch]=v<0?0:v>255?255:v; }
      const avg=p[i]*0.299+p[i+1]*0.587+p[i+2]*0.114;
      for(let ch=0;ch<3;ch++){ p[i+ch]=Math.max(0,Math.min(255, avg+(p[i+ch]-avg)*sat)); }
    }
    x.putImageData(d,0,0);
    const g=x.createRadialGradient(w/2,h/2,Math.min(w,h)*0.3,w/2,h/2,Math.max(w,h)*0.75);
    g.addColorStop(0,'rgba(255,255,255,0)'); g.addColorStop(1,'rgba(255,255,255,0.55)');
    x.fillStyle=g; x.fillRect(0,0,w,h);
    W.img=c.toDataURL('image/jpeg',0.8); W.enhanced=true; ui.cmp=55; save(); render(); toast('✨ ✓');
  };
  img.src = W.raw;
}

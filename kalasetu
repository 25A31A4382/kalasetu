<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#4f46e5">
<link rel="manifest" href='data:application/manifest+json,{"name":"KalaSetu","short_name":"KalaSetu","display":"standalone","start_url":".","background_color":"%234f46e5","theme_color":"%234f46e5"}'>
<title>KalaSetu — Simple AI Marketplace for Artisans</title>
<style>
  :root{
    --ink:#1e293b; --mut:#64748b; --bg:#f6f7fb; --card:#ffffff; --line:#e2e8f0;
    --pri:#4f46e5; --pri2:#4338ca; --acc:#f59e0b; --grn:#16a34a; --red:#dc2626; --blu:#2563eb;
    --prid:#eef2ff; --accd:#fffbeb; --grnd:#f0fdf4; --redd:#fef2f2; --blud:#eff6ff;
    --rad:16px; --sh:0 1px 3px rgba(15,23,42,.08),0 4px 14px rgba(15,23,42,.06);
  }
  *{box-sizing:border-box; margin:0; padding:0}
  html{-webkit-text-size-adjust:100%}
  body{font-family:'Segoe UI',system-ui,-apple-system,Roboto,'Noto Sans Devanagari','Noto Sans Telugu','Noto Sans Tamil',Arial,sans-serif; background:var(--bg); color:var(--ink); font-size:16px; line-height:1.5; padding-bottom:80px}
  #app{max-width:1060px; margin:0 auto; padding:0 14px}

  header{position:sticky; top:0; z-index:50; background:#fff; border-bottom:1px solid var(--line)}
  .hwrap{max-width:1060px; margin:0 auto; padding:8px 14px; display:flex; align-items:center; gap:10px; flex-wrap:wrap}
  .logo{display:flex; align-items:center; gap:8px; font-weight:800; font-size:19px; color:var(--pri2); cursor:pointer; white-space:nowrap}
  .logo .lmark{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#4f46e5,#f59e0b);display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px}
  .spacer{flex:1}
  .hbtn{border:1px solid var(--line); background:#fff; border-radius:10px; padding:7px 12px; font-size:14px; cursor:pointer; color:var(--ink); white-space:nowrap}
  .hbtn:hover{background:#f8fafc}
  .bell{position:relative}
  .bell .dot{position:absolute; top:-5px; right:-5px; background:var(--red); color:#fff; font-size:10px; min-width:17px; height:17px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-weight:700; padding:0 3px}
  select.lang{border:1px solid var(--line); border-radius:10px; padding:7px 8px; font-size:14px; background:#fff; cursor:pointer; font-weight:700; color:var(--pri2); max-width:130px}
  .navlinks{display:flex; gap:6px; flex-wrap:wrap}
  .nlink{padding:7px 12px; border-radius:10px; font-size:14px; cursor:pointer; color:var(--mut); font-weight:700; white-space:nowrap}
  .nlink:hover{background:#f1f5f9; color:var(--ink)}
  .nlink.on{background:var(--prid); color:var(--pri2)}

  .card{background:var(--card); border:1px solid var(--line); border-radius:var(--rad); box-shadow:var(--sh); padding:18px; margin-top:16px}
  .grid{display:grid; gap:14px}
  .g2{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
  .g3{grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
  .g4{grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
  .row{display:flex; align-items:center; gap:10px; flex-wrap:wrap}
  .between{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  h1{font-size:26px; margin:18px 0 4px}
  h2{font-size:20px; margin-bottom:8px}
  h3{font-size:16px}
  .sub{color:var(--mut); font-size:14px}
  .mt{margin-top:14px} .mt8{margin-top:8px} .mb{margin-bottom:12px}
  hr{border:0; border-top:1px solid var(--line); margin:14px 0}
  .right{margin-left:auto}
  .center{text-align:center}

  .btn{display:inline-flex; align-items:center; gap:8px; border:0; border-radius:13px; padding:13px 22px; font-size:16px; font-weight:800; cursor:pointer; background:var(--pri); color:#fff; transition:.15s}
  .btn:hover{background:var(--pri2)}
  .btn.sec{background:#fff; color:var(--ink); border:1.5px solid var(--line)}
  .btn.sec:hover{background:#f8fafc}
  .btn.grn{background:var(--grn)} .btn.grn:hover{background:#15803d}
  .btn.red{background:var(--red)} .btn.red:hover{background:#b91c1c}
  .btn.amb{background:var(--acc); color:#3b2f00} .btn.amb:hover{background:#d97706}
  .btn.sm{padding:9px 15px; font-size:14px; border-radius:10px}
  .btn.big{width:100%; justify-content:center; font-size:18px; padding:16px}
  .btn:disabled{opacity:.5; cursor:not-allowed}

  .b{display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:800; padding:4px 11px; border-radius:99px; white-space:nowrap}
  .b.pending{background:var(--accd); color:#92400e; border:1px solid #fde68a}
  .b.approved{background:var(--grnd); color:#166534; border:1px solid #bbf7d0}
  .b.rejected{background:var(--redd); color:#991b1b; border:1px solid #fecaca}
  .b.info{background:var(--blud); color:#1e40af; border:1px solid #bfdbfe}
  .b.grey{background:#f1f5f9; color:#475569; border:1px solid var(--line)}
  .b.sms{background:var(--redd); color:#991b1b; border:1px solid #fecaca}
  .b.wa{background:#e7f8ee; color:#0f766e; border:1px solid #a7f3d0}
  .b.inapp{background:var(--prid); color:var(--pri2); border:1px solid #c7d2fe}

  label{display:block; font-size:14px; font-weight:800; color:var(--mut); margin:14px 0 6px}
  input[type=text],input[type=tel],input[type=number],select,textarea{width:100%; border:1.5px solid var(--line); border-radius:12px; padding:12px 14px; font-size:16px; font-family:inherit; background:#fff; color:var(--ink); outline:none}
  input:focus,select:focus,textarea:focus{border-color:var(--pri)}
  textarea{resize:vertical; min-height:80px}

  /* landing */
  .hero{background:linear-gradient(135deg,#312e81 0%,#4f46e5 55%,#7c3aed 100%); border-radius:22px; color:#fff; padding:40px 30px; margin-top:18px; position:relative; overflow:hidden}
  .hero:before{content:'🧵'; position:absolute; font-size:150px; right:26px; top:-18px; opacity:.14; transform:rotate(-12deg)}
  .hero h1{color:#fff; font-size:32px; margin:10px 0 8px; max-width:600px}
  .hero p{opacity:.94; max-width:560px; font-size:16.5px}
  .hero .btn{background:#fff; color:var(--pri2); margin-top:16px}
  .rolecard{cursor:pointer; transition:.15s; text-align:center; padding:26px 12px}
  .rolecard:hover{transform:translateY(-3px); border-color:var(--pri); box-shadow:0 8px 24px rgba(79,70,229,.14)}
  .rolecard .ric{width:60px; height:60px; margin:0 auto 10px; border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:29px}
  .howrow{display:flex; align-items:center; gap:12px; padding:12px 0}
  .howrow .hic{font-size:28px}
  .demo-cred{background:var(--accd); border:1px dashed #f59e0b; text-align:center}

  /* big tiles (artisan home) */
  .tile{cursor:pointer; text-align:center; padding:30px 10px}
  .tile:hover{transform:translateY(-3px); border-color:var(--pri); box-shadow:0 8px 24px rgba(79,70,229,.14)}
  .tile .tic{font-size:42px}
  .tile .tl1{font-weight:800; font-size:17px; margin-top:8px}
  .tile .tl2{font-size:13px; color:var(--mut); margin-top:2px}

  /* auth */
  .authbox{max-width:460px; margin:36px auto}
  .otprow{display:flex; gap:9px; justify-content:center; margin:16px 0}
  .otp{width:48px; height:56px; text-align:center; font-size:24px; font-weight:800; border:2px solid var(--line); border-radius:12px}
  .otp:focus{border-color:var(--pri)}
  .demoOtp{background:var(--blud); border:1px dashed var(--blu); border-radius:12px; padding:12px; text-align:center; font-weight:800; color:#1e40af; margin-top:12px; font-size:17px}

  /* products */
  .pcard{padding:0; overflow:hidden; cursor:pointer; transition:.15s}
  .pcard:hover{transform:translateY(-3px); box-shadow:0 10px 26px rgba(15,23,42,.13)}
  .pimg{width:100%; aspect-ratio:1/1; object-fit:cover; display:block; background:#f1f5f9}
  .pbody{padding:13px 15px}
  .pname{font-weight:800; font-size:15px; line-height:1.35}
  .pprice{font-size:18px; font-weight:800; color:var(--pri2); margin-top:4px}
  .pmeta{font-size:12.5px; color:var(--mut); margin-top:4px}
  .thumb{width:64px; height:64px; border-radius:12px; object-fit:cover; border:1px solid var(--line); flex-shrink:0}

  /* wizard */
  .steps{display:flex; gap:8px; margin:6px 0 2px}
  .stp{flex:1; text-align:center; font-size:15px; font-weight:800; color:var(--mut); padding:12px 4px; border-radius:12px; background:#f1f5f9}
  .stp.on{background:var(--pri); color:#fff}
  .stp.done{background:var(--grnd); color:#166534}
  .upbox{border:2px dashed #c7d2fe; border-radius:16px; padding:40px 20px; text-align:center; background:var(--prid); cursor:pointer}
  .upbox:hover{border-color:var(--pri)}
  .big{font-size:44px}
  .cmp{position:relative; border-radius:16px; overflow:hidden; max-width:460px; margin:10px auto; border:1px solid var(--line)}
  .cmp img{width:100%; display:block}
  .cmp .orig{position:absolute; inset:0; overflow:hidden; border-right:2px solid #fff}
  .cmp .tagb{position:absolute; bottom:8px; font-size:11px; font-weight:800; background:rgba(0,0,0,.55); color:#fff; padding:2px 9px; border-radius:99px}
  input[type=range].cmpR{width:100%; max-width:460px; display:block; margin:6px auto}
  .errbox{background:var(--redd); border:1.5px solid #fecaca; color:#991b1b; border-radius:12px; padding:14px; font-weight:800; margin-top:12px; text-align:center; font-size:15.5px}
  .okbox{background:var(--grnd); border:1.5px solid #bbf7d0; color:#166534; border-radius:12px; padding:10px 14px; font-weight:800; margin-top:12px; text-align:center}
  .mic{width:86px; height:86px; border-radius:50%; background:var(--red); color:#fff; font-size:34px; border:0; cursor:pointer; box-shadow:0 6px 18px rgba(220,38,38,.4); transition:.15s}
  .mic:hover{transform:scale(1.06)}
  .mic.rec{animation:pulse 1s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(220,38,38,.5)}70%{box-shadow:0 0 0 18px rgba(220,38,38,0)}100%{box-shadow:0 0 0 0 rgba(220,38,38,0)}}
  .micwrap{text-align:center; padding:16px 0}
  .lchip{padding:9px 15px; border-radius:99px; border:1.5px solid var(--line); background:#fff; font-weight:800; font-size:14px; cursor:pointer; color:var(--ink)}
  .lchip.on{background:var(--pri); color:#fff; border-color:var(--pri)}
  .chiprow{display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin:10px 0}
  .aigen{background:linear-gradient(135deg,var(--prid),#fdf4ff); border:1px solid #c7d2fe; border-radius:14px; padding:16px}
  .pricecard{background:linear-gradient(135deg,#fffbeb,#fef3c7); border:1px solid #fcd34d}
  .bignum{font-size:36px; font-weight:800; color:#92400e}
  .srcnote{font-size:12px; color:#92700c; margin-top:6px}

  /* timeline */
  .tl{position:relative; padding-left:26px}
  .tl:before{content:''; position:absolute; left:8px; top:6px; bottom:6px; width:2px; background:var(--line)}
  .tli{position:relative; padding:6px 0}
  .tli:before{content:''; position:absolute; left:-24px; top:11px; width:12px; height:12px; border-radius:50%; background:#cbd5e1; border:2px solid #fff; box-shadow:0 0 0 2px #cbd5e1}
  .tli.done:before{background:var(--grn); box-shadow:0 0 0 2px var(--grn)}

  /* alerts */
  .notif{display:flex; gap:12px; align-items:flex-start; padding:13px 6px; border-bottom:1px solid var(--line)}
  .notif:last-child{border-bottom:0}
  .nic{width:38px; height:38px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0}
  .ntime{font-size:11.5px; color:var(--mut)}
  .pillTabs{display:flex; gap:8px; flex-wrap:wrap; margin-top:14px}
  .ptab{padding:9px 17px; border-radius:99px; border:1.5px solid var(--line); background:#fff; font-size:14px; font-weight:800; cursor:pointer; color:var(--mut)}
  .ptab.on{background:var(--pri); border-color:var(--pri); color:#fff}

  /* support */
  .faq details{border-bottom:1px solid var(--line)}
  .faq details:last-child{border-bottom:0}
  .faq summary{padding:14px 16px; font-weight:800; cursor:pointer; font-size:15.5px; background:#fff; border-radius:12px}
  .faq summary:hover{background:#f8fafc}
  .faq .fa{padding:0 16px 14px; color:var(--mut); font-size:14.5px}
  .gstep{display:flex; gap:12px}
  .gnum{width:32px; height:32px; border-radius:50%; background:var(--pri); color:#fff; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:15px}

  /* chat */
  #chatBtn{position:fixed; right:18px; bottom:18px; width:58px; height:58px; border-radius:50%; background:var(--pri); color:#fff; font-size:26px; border:0; cursor:pointer; box-shadow:0 8px 22px rgba(79,70,229,.45); z-index:70}
  #chatBox{position:fixed; right:18px; bottom:86px; width:min(340px, calc(100vw - 36px)); background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:0 16px 44px rgba(15,23,42,.22); z-index:70; display:none; flex-direction:column; overflow:hidden}
  #chatBox.open{display:flex}
  .chead{background:var(--pri); color:#fff; padding:12px 15px; font-weight:800; font-size:14px}
  #chatMsgs{padding:12px; max-height:280px; overflow-y:auto; display:flex; flex-direction:column; gap:8px; background:#f8fafc}
  .cmsg{max-width:85%; padding:9px 12px; border-radius:13px; font-size:14px; line-height:1.45}
  .cmsg.bot{background:#fff; border:1px solid var(--line); align-self:flex-start}
  .cmsg.me{background:var(--pri); color:#fff; align-self:flex-end}
  .cinput{display:flex; border-top:1px solid var(--line)}
  .cinput input{border:0; border-radius:0; flex:1}
  .cinput button{border:0; background:var(--pri); color:#fff; padding:0 18px; font-weight:800; cursor:pointer}

  #toast{position:fixed; left:50%; bottom:26px; transform:translateX(-50%) translateY(120px); background:var(--ink); color:#fff; padding:12px 22px; border-radius:12px; font-size:15px; z-index:99; transition:.3s; max-width:90vw; text-align:center; box-shadow:0 10px 30px rgba(0,0,0,.3)}
  #toast.show{transform:translateX(-50%) translateY(0)}
  .empty{text-align:center; color:var(--mut); padding:36px 10px}
  .empty .eic{font-size:46px; margin-bottom:8px}
  .stat .sv{font-size:26px; font-weight:800; color:var(--pri2)}
  .stat .sl{font-size:12.5px; color:var(--mut); font-weight:800}
  .foot{text-align:center; color:#94a3b8; font-size:12.5px; margin:30px 0 10px}
  .kv{display:flex; justify-content:space-between; gap:10px; padding:8px 0; border-bottom:1px dashed var(--line); font-size:14.5px}
  .kv:last-child{border-bottom:0}
  @media(max-width:640px){ .hero{padding:30px 20px} .hero h1{font-size:25px} .otp{width:42px;height:50px} }
</style>
</head>
<body>
<div id="app"></div>
<button id="chatBtn" onclick="toggleChat()" title="Support">💬</button>
<div id="chatBox">
  <div class="chead">🛡️ <span id="chatTitle">KalaSetu Support</span></div>
  <div id="chatMsgs"></div>
  <div class="cinput"><input id="chatIn" type="text" onkeydown="if(event.key==='Enter')chatSend()"><button onclick="chatSend()">➤</button></div>
</div>
<div id="toast"></div>


function orderCard(o){
  const p = prodById(o.productId);
  const isCust = me() && me().role==='customer';
  const steps = ['placed','assigned','picked','out','delivered','paid'];
  const labels = {placed:'st_placed', assigned:'st_assigned', picked:'st_picked', out:'st_out', delivered:'st_delivered', paid:'st_paid', rt_requested:'rt_requested', rt_picked:'rt_picked', rt_refunded:'rt_refunded'};
  if(o.return || ['rt_requested','rt_picked','rt_refunded'].indexOf(o.status)>=0){ steps.push('rt_requested','rt_picked','rt_refunded'); }
  const idx = steps.indexOf(o.status);
  const agent = userById(o.logisticsId);
  const stCls = (o.status==='paid'||o.status==='rt_refunded')?'approved':'pending';
  /* customer return request UI */
  let retUi = '';
  if(isCust && o.status==='paid' && !o.return){
    retUi = '<div class="mt"><button class="btn sec sm" onclick="toggleRet('+o.id+')">'+t('return_req')+'</button>';

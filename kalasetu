function otpNext(i,v){ if(v && i<5) document.getElementById('otp'+(i+1)).focus(); }
function doVerifyOtp(){
  const code = [0,1,2,3,4,5].map(i=>document.getElementById('otp'+i).value).join('');
  if(code !== S.otps[ui.phone]){ toast(t('wrong_otp')); return; }
  toast(t('otp_verified'));
  delete S.otps[ui.phone];
  let user = S.users.find(u=>u.phone===ui.phone && u.role===ui.authRole);
  if(!user && ui.authRole==='artisan' && regDraft){
    const fno = (regDraft.docNo||'').replace(/\D/g,'');
    const fmat = fno.length===12 ? (fno.slice(0,4)+' '+fno.slice(4,8)+' '+fno.slice(8)) : (regDraft.docNo||'—');
    user = Object.assign({id:uid(), role:'artisan', status:'pending', created:now(), addr:'', doc:'Aadhaar •••• '+fno.slice(-4), docImg:svgAadhaar(regDraft.name, fmat)}, regDraft, {phone:ui.phone});
    S.users.push(user);
  }
  if(!user && ui.authRole==='customer'){
    user = {id:uid(), role:'customer', name:'Guest '+ui.phone.slice(-4), phone:ui.phone, status:'approved', addr:'', created:now()};
    S.users.push(user);
  }
  if(!user && (ui.authRole==='verifier'||ui.authRole==='logistics')){
    user = S.users.find(u=>u.role===ui.authRole);
  }
  if(user && user.role==='artisan' && user.lang){ S.lang = user.lang; }
  S.session = user.id; save();
  go('home');
}

/* selfie capture for registration (downscaled, stored on artisan profile) */
function selfiePicked(el){
  const f = el.files && el.files[0]; if(!f) return;
  const rd = new FileReader();
  rd.onload = function(){
    const img = new Image();
    img.onload = function(){
      const c=document.createElement('canvas');
      let w=img.width,h=img.height; const sc=Math.min(1,280/Math.max(w,h)); w=Math.round(w*sc); h=Math.round(h*sc);
      c.width=w; c.height=h; c.getContext('2d').drawImage(img,0,0,w,h);
      regDraft.selfie = c.toDataURL('image/jpeg',0.8);
      render();
    };
    img.src = rd.result;
  };
  rd.readAsDataURL(f);
}
function sendOtp(phone){
  ui.otpCode = String(100000 + Math.floor(Math.random()*900000));
  S.otps[phone] = ui.otpCode;   /* production: SMS gateway (MSG91/Twilio) sends this */
  ui.authStep='otp'; render();
}
